{
  "name": "@chatty-buddy/react",
  "description": "Drop-in React component for RAG-powered chatbots with multi-provider LLM support",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    }
  },
  "bin": {
    "chatty-buddy-server": "./bin/server.ts"
  },
  "files": [
    "src",
    "bin",
    "dist"
  ],
  "keywords": [
    "react",
    "chatbot",
    "rag",
    "llm",
    "ai",
    "nvidia",
    "ollama",
    "openai",
    "anthropic",
    "google",
    "chromadb",
    "vector-database"
  ],
  "author": "",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "chromadb": "^1.9.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
