{
  "name": "@chatty-buddy/react",
  "description": "Drop-in React component for RAG-powered chatbots with multi-provider LLM support",
  "version": "0.3.16",
  "type": "module",
  "sideEffects": ["*.css"],
  "main": "dist/browser.js",
  "module": "dist/browser.js",
  "types": "dist/browser.d.ts",
  "exports": {
    ".": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    },
    "./styles.css": "./dist/browser.css",
    "./server": {
      "types": "./dist/index.server.d.ts",
      "import": "./dist/index.server.js",
      "require": "./dist/index.server.cjs"
    }
  },
  "bin": {
    "chatty-buddy-server": "./dist/server.cli.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "react",
    "chatbot",
    "rag",
    "llm",
    "ai",
    "nvidia",
    "ollama",
    "openai",
    "anthropic",
    "google",
    "sqlite",
    "vector-database"
  ],
  "author": "",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1",
    "react-markdown": "^10.1.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "optionalDependencies": {
    "chromadb": "^1.9.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.0"
  }
}
